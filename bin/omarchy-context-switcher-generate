#!/bin/bash
# omarchy-context-switcher-generate: generate keybindings + the system-menu extension
# from ~/.config/context-switcher/config.json for the Context Switcher plugin.
#
# Outputs (to stdout):
#   --bindings   Lua keybindings (Super+Alt+<shortcut> context menu,
#                Super+Alt+. context picker, slots, cycling)
#   --menu       omarchy-menu.jsonc system-menu extension: a "Contexts"
#                section whose submenus launch items and carry the
#                management actions (add/edit/modify) that open the editor.
set -euo pipefail

CONFIG_FILE="${HOME}/.config/context-switcher/config.json"
[[ -f "$CONFIG_FILE" ]] || { echo "error: $CONFIG_FILE not found" >&2; exit 1; }
CONFIG=$(cat "$CONFIG_FILE")
[[ -n "$CONFIG" ]] || { echo "error: empty config" >&2; exit 1; }

current=""
 while (( $# )); do
  case "$1" in
    --bindings) mode=bindings ;;
    --menu) mode=menu ;;
    --context) current="${2:-}"; shift ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
 done
[[ -n "$mode" ]] || { echo "usage: $0 --bindings|--menu [--context <id>]" >&2; exit 1; }

gen_bindings() {
  cat <<'LUA'
-- Generated by omarchy-context-switcher-generate. Source: ~/.config/context-switcher/config.json.
-- Context Switcher keybindings.

-- Context picker (all contexts).
o.bind("SUPER + ALT + PERIOD", "Context menu", "omarchy-context-switcher menu")

LUA
  echo "$CONFIG" | jq -r '
    .contexts[] | select(.shortcut != null and .shortcut != "") |
    "o.bind(\"SUPER + ALT + " + (.shortcut | ascii_upcase) + "\", \"" + (.name // .id) + " menu\", \"omarchy-context-switcher menu " + .id + "\")"
  '
  echo
  # Slot keys: SUPER+1..0 goto, SUPER+SHIFT+1..0 move, SUPER+SHIFT+ALT+1..0 move-silent.
  cat <<'LUA'
-- Slot keys within the active context (uses code:10..19 for the number row).
-- Unbind Omarchy's default workspace-switching binds first.
LUA
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + ALT + code:" + $c + "\")" )
  '
  echo
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    [ range(1; $slots + 1) ] as $nums |
    ( $nums[] as $n |
      "o.bind(\"SUPER + code:" + (($n + 9) | tostring) + "\", \"Context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher goto " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + code:" + (($n + 9) | tostring) + "\", \"Move to context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher move " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + ALT + code:" + (($n + 9) | tostring) + "\", \"Silent move to context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher move-silent " + ($n | tostring) + "\")" )
  '
  echo
  cat <<'LUA'
-- Cycle workspaces globally within contexts.
hl.unbind("SUPER + TAB")
hl.unbind("SUPER + SHIFT + TAB")
o.bind("SUPER + TAB", "Cycle workspace next", "omarchy-context-switcher cycle next")
o.bind("SUPER + SHIFT + TAB", "Cycle workspace previous", "omarchy-context-switcher cycle prev")

-- Cycle the active workspace to the next/prev monitor (context-aware).
hl.unbind("SUPER + backslash")
o.bind("SUPER + backslash", "Move workspace to next monitor", "omarchy-context-switcher cycle-monitor next")
o.bind("SUPER + SHIFT + backslash", "Move workspace to previous monitor", "omarchy-context-switcher cycle-monitor prev")
LUA
}

# System-menu extension: a "Contexts" section. Each context is a submenu of
# launch items plus management actions (go-to, move-ws, modify items, edit)
# that summon the dedicated editor. "Add context" and "Edit JSON file" sit at
# the bottom of the picker.
gen_menu() {
  echo "$CONFIG" | jq --arg current "$current" '
    # One "Edit <folder>" entry per folder in the context, recursing into nested
# folders (path-encoded action; dot-free key to stay a single menu route).
def emit_folder_edits($cid; $base; $path; $items):
  reduce ($items | to_entries)[] as $e (.;
    if ($e.value.type // "") == "submenu" then
      (($e.key|tostring) as $k
       | ($path + (if $path == "" then $k else ("_" + $k) end)) as $p
       | .[($base + ".ef" + $p)] = { icon: "󰉋", label: ("Edit " + ($e.value.label // "")),
           action: ("omarchy-context-switcher reorder " + $cid + " " + (if $path == "" then $k else ($path + "." + $k) end)) }
       | emit_folder_edits($cid; $base; $p; ($e.value.items // [])))
    else . end);

def emit_edit($cid; $base; $path; $label; $items; $detailsAction):
  .[($base + ".~edit")] = { icon: "󰏪", label: ("Edit " + $label), action: ("omarchy-context-switcher reorder " + $cid + (if $path == "" then "" else (" " + $path) end)) }
  | .[($base + ".~edit.menu")] = { icon: "󰏪", label: ("Edit " + $label) }
  | .[($base + ".~edit.menu.!details")] = { icon: "󰏪", label: "Edit details", action: $detailsAction }
  | .[($base + ".~edit.menu.!add")] = { icon: "󰐕", label: "Add item", action: ("omarchy-context-switcher edit-item " + $cid + " " + (if $path == "" then "add" else ($path + ".add") end)) }
  | .[($base + ".~edit.menu.!reorder")] = { icon: "", label: "Move/Edit Items", action: ("omarchy-context-switcher reorder " + $cid + (if $path == "" then "" else (" " + $path) end)) }
  | emit_folder_edits($cid; ($base + ".~edit.menu"); ""; $items);

    def emit_items($cid; $base; $path; $profile; $items):
      reduce ($items | to_entries)[] as $e (.;
        if ($e.value.type // "") == "browser" then .
        elif ($e.value.type // "") == "submenu" then
          (($e.key|tostring) as $k
           | ($path + (if $path == "" then "" else "." end) + $k) as $p
           | ($base + "." + $e.value.label) as $sub
                  | (if ($e.value.icon // "") == "" then "󰉋" else $e.value.icon end) as $ic
       | .[$sub] = { icon: $ic, label: $e.value.label, target: $sub }
       | emit_items($cid; $sub; $p; $profile; ($e.value.items // [])))
        elif ($e.value.type // "") == "web" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰅂"), label: $e.value.label, action: ("omarchy-context-switcher-launch " + ($profile | @json) + " " + ($e.value.url | @json)) }
        elif ($e.value.type // "") == "mosh" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰒵"), label: $e.value.label, action: ("alacritty --title " + ($e.value.label | @json) + " -e mosh " + ($e.value.host | @json)) }
        elif ($e.value.type // "") == "ssh" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰒵"), label: $e.value.label, action: ("alacritty --title " + ($e.value.label | @json) + " -e ssh " + ($e.value.host | @json)) }
        elif ($e.value.type // "") == "terminal" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰆍"), label: $e.value.label, action: ("alacritty --title " + ($e.value.label | @json) + " -e sh -c " + ($e.value.command | @json)) }
        else
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰆍"), label: $e.value.label, action: $e.value.command }
        end);

    def emit_context($ctx):
      ($ctx.id) as $cid
      | ($ctx.icon // "󰯆") as $ic
      | ($ctx.name // $cid) as $cn
      | ($ctx.menu // []) as $items
      | ($ctx.chrome_profile // "") as $explicit
      | (.default_chrome_profile // "Default") as $dp
      | (if $explicit == "" then $dp else $explicit end) as $profile
      | .[("contexts." + $cid)] = { icon: $ic, label: $cn, target: ("contexts." + $cid + ".menu") }
      | .[("contexts." + $cid + ".menu")] = { icon: $ic, label: $cn }
      | (if ($current // "") == $cid then .
         else
           .[("contexts." + $cid + ".menu.!go-to")] = { icon: "󰁔", label: ("Go to " + $cn), action: ("omarchy-context-switcher switch " + $cid) }
           | .[("contexts." + $cid + ".menu.!move-ws")] = { icon: "󰄾", label: ("Move to " + $cn), action: ("omarchy-context-switcher move-workspace " + $cid) }
         end)
      | (if $explicit != "" then
           .[("contexts." + $cid + ".menu.!browser")] = { icon: "󰖟", label: "Browser", action: ("omarchy-context-switcher-launch " + ($profile | @json)) }
         else . end)
      | emit_items($cid; ("contexts." + $cid + ".menu"); ""; $profile; $items)
      | emit_edit($cid; ("contexts." + $cid + ".menu"); ""; $cn; $items; ("omarchy-context-switcher edit " + $cid));

    reduce .contexts[] as $ctx ({}; . + (emit_context($ctx)))
    | { contexts: { icon: "󰯆", label: "Contexts" } }
    + .
    + { "contexts.~add": { icon: "", label: "Add context", action: "omarchy-context-switcher edit new" },
        "contexts.~json": { icon: "", label: "Edit Config", action: "omarchy-context-switcher edit-json" },
        "contexts.~reload": { icon: "", label: "Reload config", action: "omarchy-context-switcher reload" } }' 2>&1
}

if [[ "$mode" == "bindings" ]]; then
  gen_bindings
else
  gen_menu
fi
