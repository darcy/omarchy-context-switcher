#!/bin/bash
# omarchy-context-switcher-generate: generate keybindings + the system-menu extension
# from ~/.config/context-switcher/config.json for the Context Switcher plugin.
#
# Outputs (to stdout):
#   --bindings   Lua keybindings (Super+Alt+<shortcut> context menu,
#                Super+Alt+. context picker, slots, cycling)
#   --menu       omarchy-menu.jsonc system-menu extension: a "Contexts"
#                section whose submenus launch items and carry the
#                management actions (add/edit/modify) that open the editor.
set -euo pipefail

CONFIG_FILE="${CONFIG_FILE:-${HOME}/.config/context-switcher/config.json}"
[[ -f "$CONFIG_FILE" ]] || { echo "error: $CONFIG_FILE not found" >&2; exit 1; }
SIZE=$(stat -c %s "$CONFIG_FILE" 2>/dev/null || echo 0)
if [[ ! "$SIZE" =~ ^[0-9]+$ || "$SIZE" -gt 262144 ]]; then
  echo "error: $CONFIG_FILE exceeds the 256 KiB limit" >&2; exit 1
fi
# Bounded + timeout: a replaced FIFO or huge file can't stall or inflate us.
CONFIG=$(timeout 5 cat "$CONFIG_FILE")
[[ -n "$CONFIG" ]] || { echo "error: empty config" >&2; exit 1; }

current=""
mode=""
merge=""
strip=""
while (( $# )); do
  case "$1" in
    --bindings) mode=bindings ;;
    --menu) mode=menu ;;
    --context) current="${2:-}"; shift ;;
    --merge) merge="${2:-}"; shift ;;
    --strip-menu) strip="${2:-}"; shift ;;
    --selftest) mode=selftest ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
done

# One runnable check for the non-trivial bits: comment-stripping before jq and
# the "Go to <ctx>" hiding. Fails loudly if the logic breaks.
selftest() {
  local f
  f=$(mktemp) || exit 1
  printf '{\n  // managed block\n  "hey-tui": {"label":"HEY"},\n}\n' > "$f"
  local out
  out=$(strip_comments "$f")
  [[ "$out" == *'"hey-tui"'* ]] || { echo "selftest: comments not stripped"; rm -f "$f"; exit 1; }
  [[ "$out" != *'//'* ]] || { echo "selftest: comment survived"; rm -f "$f"; exit 1; }
  rm -f "$f"

  # Reuse a temp config: hide "Go to <current>", show every other context.
  local cf conf gen
  cf=$(mktemp) || exit 1
  conf='{"slots":10,"chromium_browser":"chromium","default_chrome_profile":"Default","contexts":[{"id":"a","name":"Alpha"},{"id":"b","name":"Bravo"},{"id":"c","name":"Charlie"}]}'
  printf '%s' "$conf" > "$cf"
  gen=$(CONFIG_FILE="$cf" $0 --menu --context b 2>&1) || { echo "selftest: menu gen failed"; rm -f "$cf"; exit 1; }
  echo "$gen" | grep -q '"contexts.b.menu.!go-to"' && { echo "selftest: go-to not hidden for current"; rm -f "$cf"; exit 1; }
  echo "$gen" | grep -q 'Go to Alpha' || { echo "selftest: go-to Alpha missing"; rm -f "$cf"; exit 1; }
  rm -f "$cf"
  echo "selftest: ok"
}
[[ -n "$mode" || -n "$strip" ]] || { echo "usage: $0 --bindings|--menu [--context <id>] [--merge <menu-ext>] | --strip-menu <menu-ext>" >&2; exit 1; }

gen_bindings() {
  cat <<'LUA'
-- Context Switcher workspace guard v2: contexts are virtual workspace-managers,
-- each with its own block, owned by one monitor. Every monitor keeps its
-- Omarchy default block as a permanent fallback. Loaded after
-- default.hypr.monitor-workspaces so it can replace reconcile/focus behaviour
-- without disabling the per-monitor block model.
local function context_switcher_workspaces()
  local base = o.workspaces
  if not base then
    return nil
  end

  local SLOTS = 10
  local state_home = os.getenv("XDG_STATE_HOME") or ((os.getenv("HOME") or "") .. "/.local/state")
  local MAP_PATH = state_home .. "/context-switcher/blocks.lua"
  local SETTLED_PATH = state_home .. "/context-switcher/reconcile-state"

  local C = {}
  C.slots = SLOTS

  local map = nil

  local function load_map()
    local ok, value = pcall(dofile, MAP_PATH)
    if ok and type(value) == "table" then
      map = value
      return true
    end
    map = nil
    return false
  end

  local function load_settled()
    local generation, monitor_set = -1, ""
    local file = io.open(SETTLED_PATH, "r")
    if file then
      generation = tonumber(file:read("*l")) or -1
      monitor_set = file:read("*l") or ""
      file:close()
    end
    return generation, monitor_set
  end

  local function save_settled(generation, monitor_set)
    local file = io.open(SETTLED_PATH, "w")
    if file then
      file:write(tostring(generation) .. "\n" .. monitor_set .. "\n")
      file:close()
    end
  end

  local function identities_of(monitors)
    local ordered = {}
    for _, monitor in ipairs(monitors) do
      ordered[#ordered + 1] = monitor
    end
    table.sort(ordered, function(left, right)
      local left_internal = (left.name or ""):match("^eDP") or (left.name or ""):match("^LVDS") or (left.name or ""):match("^DSI")
      local right_internal = (right.name or ""):match("^eDP") or (right.name or ""):match("^LVDS") or (right.name or ""):match("^DSI")
      if (left_internal ~= nil) ~= (right_internal ~= nil) then
        return left_internal ~= nil
      end
      return (left.name or "") < (right.name or "")
    end)

    local seen = {}
    local identities = {}
    for _, monitor in ipairs(ordered) do
      local base_name = monitor.description or ""
      if base_name == "" then
        base_name = monitor.name or ""
      end
      local identity = base_name
      if seen[identity] then
        identity = base_name .. " #" .. (monitor.name or "")
      end
      seen[identity] = true
      identities[monitor.name] = identity
    end
    return identities
  end

  local function monitor_identity(monitor, identities)
    return identities[monitor.name] or monitor.name or ""
  end

  local function connected(gone)
    local monitors = {}
    for _, monitor in ipairs(hl.get_monitors()) do
      if not monitor.is_mirror and monitor.name ~= gone then
        monitors[#monitors + 1] = monitor
      end
    end
    return monitors
  end

  local function monitor_set_hash(monitors, identities)
    local parts = {}
    for _, monitor in ipairs(monitors) do
      parts[#parts + 1] = monitor_identity(monitor, identities) .. "|" .. (monitor.name or "")
    end
    table.sort(parts)
    return table.concat(parts, ";")
  end

  local function context_block(context)
    if map and map.context_blocks then
      return map.context_blocks[context]
    end
    return nil
  end

  local function context_owner(context)
    if map and map.context_monitor then
      return map.context_monitor[context]
    end
    return nil
  end

  local function default_block(identity)
    if map and map.default_blocks then
      return map.default_blocks[identity]
    end
    return nil
  end

  local function active_context(identity)
    if map and map.active then
      return map.active[identity]
    end
    return nil
  end

  local function active_block(identity)
    local context = active_context(identity)
    if context then
      return context_block(context)
    end
    return default_block(identity)
  end

  local function workspace_id(identity, slot)
    local block = active_block(identity)
    if not block then
      return nil
    end
    return block * SLOTS + slot
  end

  local function regular(workspace)
    return workspace and not workspace.special and workspace.id > 0
  end

  local function block_of(id)
    return math.floor((id - 1) / SLOTS)
  end

  local function move_workspace_to(id, monitor_name)
    local workspace = hl.get_workspace(id)
    if workspace and workspace.monitor and workspace.monitor.name ~= monitor_name then
      hl.dispatch(hl.dsp.workspace.move({ workspace = tostring(id), monitor = monitor_name }))
    end
  end

  local function show(monitor, id)
    local workspace = hl.get_workspace(id)
    if workspace and workspace.monitor and workspace.monitor.name ~= monitor.name then
      move_workspace_to(id, monitor.name)
      workspace = hl.get_workspace(id)
    end
    hl.dispatch(hl.dsp.focus({ monitor = monitor.name }))
    hl.dispatch(hl.dsp.focus({ workspace = tostring(id) }))
  end

  local function settle(monitor, identities)
    local identity = monitor_identity(monitor, identities)
    local block = active_block(identity)
    if not block then
      return
    end
    local active = monitor.active_workspace
    if regular(active) and block_of(active.id) ~= block then
      show(monitor, block * SLOTS + 1)
    end
  end

  -- Move the active workspace into the target monitor's active manager. Keep
  -- its slot number when free, otherwise take the first free slot. The
  -- workspace is renumbered into the target block: it becomes part of that
  -- context/default manager.
  local function adopt_active_workspace(target, identities)
    local workspace = hl.get_active_workspace()
    local source = hl.get_active_monitor()
    if not regular(workspace) or not source or not target then
      return
    end
    local target_identity = monitor_identity(target, identities)
    local block = active_block(target_identity)
    if not block then
      return
    end

    local slot = (workspace.id - 1) % SLOTS + 1
    local target_id = nil
    if not hl.get_workspace(block * SLOTS + slot) then
      target_id = block * SLOTS + slot
    else
      for candidate = 1, SLOTS do
        local id = block * SLOTS + candidate
        if not hl.get_workspace(id) then
          target_id = id
          break
        end
      end
    end
    if not target_id then
      return
    end

    if workspace.monitor and workspace.monitor.name ~= target.name then
      hl.dispatch(hl.dsp.workspace.move({ workspace = tostring(workspace.id), monitor = target.name }))
    end
    if workspace.id ~= target_id then
      hl.dispatch(hl.dsp.workspace.change_id({ workspace = tostring(workspace.id), id = target_id }))
    end

    if source and source.name ~= target.name then
      -- Hyprland may pull another workspace onto the source monitor while the
      -- moved workspace is still settling. Settle after the move lands, then
      -- return focus to the moved workspace on the target.
      hl.timer(function()
        settle(source, identities)
        hl.dispatch(hl.dsp.focus({ monitor = target.name }))
        hl.dispatch(hl.dsp.focus({ workspace = tostring(target_id) }))
      end, { type = "oneshot", timeout = 50 })
    else
      hl.dispatch(hl.dsp.focus({ monitor = target.name }))
      hl.dispatch(hl.dsp.focus({ workspace = tostring(target_id) }))
    end
  end

  function C.reconcile(added, gone)
    if not load_map() then
      return
    end
    local monitors = connected(gone)
    if #monitors == 0 then
      return
    end
    local identities = identities_of(monitors)
    local set_hash = monitor_set_hash(monitors, identities)
    local generation = map.generation or 0
    local settled_generation, settled_set = load_settled()

    if not added and not gone and set_hash == settled_set and generation == settled_generation then
      return
    end

    local focused_window = hl.get_active_window()
    local focused_monitor = hl.get_active_monitor()
    local focused_name = focused_monitor and focused_monitor.name
    local changed = false

    -- Restore context blocks to their owner monitors.
    if map.context_blocks then
      for context, block in pairs(map.context_blocks) do
        local owner = context_owner(context)
        if owner then
          local owner_monitor = nil
          for _, monitor in ipairs(monitors) do
            if monitor_identity(monitor, identities) == owner then
              owner_monitor = monitor
              break
            end
          end
          if owner_monitor then
            for slot = 1, SLOTS do
              local id = block * SLOTS + slot
              local workspace = hl.get_workspace(id)
              if workspace and workspace.monitor and workspace.monitor.name ~= owner_monitor.name
                and (workspace.windows or 0) > 0 then
                move_workspace_to(id, owner_monitor.name)
                changed = true
              end
            end
          end
        end
      end
    end

    -- Restore default blocks to their monitors.
    if map.default_blocks then
      for owner, block in pairs(map.default_blocks) do
        local owner_monitor = nil
        for _, monitor in ipairs(monitors) do
          if monitor_identity(monitor, identities) == owner then
            owner_monitor = monitor
            break
          end
        end
        if owner_monitor then
          for slot = 1, SLOTS do
            local id = block * SLOTS + slot
            local workspace = hl.get_workspace(id)
            if workspace and workspace.monitor and workspace.monitor.name ~= owner_monitor.name
              and (workspace.windows or 0) > 0 then
              move_workspace_to(id, owner_monitor.name)
              changed = true
            end
          end
        end
      end
    end

    local function settle_monitors()
      local touched = false
      for _, monitor in ipairs(monitors) do
        local identity = monitor_identity(monitor, identities)
        local block = active_block(identity)
        if block then
          local active = monitor.active_workspace
          if regular(active) and block_of(active.id) ~= block then
            show(monitor, block * SLOTS + 1)
            touched = true
          end
        end
      end
      return touched
    end

    changed = settle_monitors() or changed
    save_settled(generation, set_hash)

    local function restore_focus()
      if focused_window and hl.get_window("address:" .. focused_window.address) then
        hl.dispatch(hl.dsp.focus({ window = "address:" .. focused_window.address }))
      elseif focused_name and focused_name ~= gone and hl.get_monitor(focused_name) then
        hl.dispatch(hl.dsp.focus({ monitor = focused_name }))
      end
    end

    if changed then
      restore_focus()
      -- Workspace moves can land after the first pass; settle once more after
      -- they have taken effect, then restore focus.
      hl.timer(function()
        settle_monitors()
        restore_focus()
      end, { type = "oneshot", timeout = 50 })
    end
  end

  function C.reload()
    load_map()
    C.reconcile()
  end

  function C.workspace_id(monitor_name, slot)
    if not load_map() then
      return nil
    end
    local monitor = monitor_name and hl.get_monitor(monitor_name) or hl.get_active_monitor()
    if not monitor then
      return nil
    end
    local identities = identities_of(hl.get_monitors())
    local identity = monitor_identity(monitor, identities)
    return workspace_id(identity, slot)
  end

  local function action(fn, expression)
    o.bind_expressions[fn] = expression
    return fn
  end

  function C.focus(slot, monitor_name)
    return action(function()
      if not load_map() then
        return
      end
      local monitor = monitor_name and hl.get_monitor(monitor_name) or hl.get_active_monitor()
      if not monitor then
        return
      end
      local identities = identities_of(hl.get_monitors())
      local identity = monitor_identity(monitor, identities)
      local id = workspace_id(identity, slot)
      if not id then
        return
      end
      if not monitor.focused then
        hl.dispatch(hl.dsp.focus({ monitor = monitor.name }))
      end
      hl.dispatch(hl.dsp.focus({ workspace = tostring(id) }))
    end, "o.workspaces.focus(" .. slot .. (monitor_name and ", " .. string.format("%q", monitor_name) or "") .. ")")
  end

  function C.move_window(slot, follow)
    return action(function()
      if not load_map() then
        return
      end
      local window = hl.get_active_window()
      local monitor = hl.get_active_monitor()
      if not window or not monitor then
        return
      end
      local identities = identities_of(hl.get_monitors())
      local identity = monitor_identity(monitor, identities)
      local id = workspace_id(identity, slot)
      if not id then
        return
      end
      hl.dispatch(hl.dsp.window.move({
        workspace = tostring(id),
        follow = follow ~= false,
        window = "address:" .. window.address,
      }))
    end, "o.workspaces.move_window(" .. slot .. (follow == false and ", false" or "") .. ")")
  end

  function C.move_to_monitor(direction)
    return action(function()
      if not load_map() then
        return
      end
      local target = hl.get_monitor(direction)
      if not target then
        return
      end
      local identities = identities_of(hl.get_monitors())
      adopt_active_workspace(target, identities)
    end, "o.workspaces.move_to_monitor(" .. string.format("%q", direction) .. ")")
  end

  function C.move_workspace_to_monitor(target_name)
    if not load_map() then
      return
    end
    local target = target_name and hl.get_monitor(target_name)
    if not target then
      return
    end
    local identities = identities_of(hl.get_monitors())
    adopt_active_workspace(target, identities)
  end

  function C.move_window_to_monitor(direction)
    return action(function()
      if not load_map() then
        return
      end
      local target = hl.get_monitor(direction)
      local window = hl.get_active_window()
      if not target or not window then
        return
      end
      local identities = identities_of(hl.get_monitors())
      local target_identity = monitor_identity(target, identities)
      local block = active_block(target_identity)
      if not block then
        return
      end
      local source = hl.get_active_monitor()
      local workspace = hl.get_active_workspace()
      local slot = workspace and (((workspace.id - 1) % SLOTS) + 1) or 1
      local target_id = block * SLOTS + slot
      local existing = hl.get_workspace(target_id)
      if existing and existing.windows and existing.windows > 0 then
        local found = false
        for candidate = 1, SLOTS do
          local id = block * SLOTS + candidate
          local candidate_workspace = hl.get_workspace(id)
          if not candidate_workspace or (candidate_workspace.windows or 0) == 0 then
            target_id = id
            found = true
            break
          end
        end
        if not found then
          return
        end
      end
      hl.dispatch(hl.dsp.window.move({
        workspace = tostring(target_id),
        follow = true,
        window = "address:" .. window.address,
      }))
      if source and source.name ~= target.name then
        settle(source, identities)
      end
      hl.dispatch(hl.dsp.focus({ monitor = target.name }))
      hl.dispatch(hl.dsp.focus({ workspace = tostring(target_id) }))
    end, "o.workspaces.move_window_to_monitor(" .. string.format("%q", direction) .. ")")
  end

  base.reconcile = C.reconcile
  o.workspaces = C
  return C
end

context_workspaces = context_switcher_workspaces()
LUA
  cat <<'LUA'
-- Generated by omarchy-context-switcher-generate. Source: ~/.config/context-switcher/config.json.
-- Context Switcher keybindings.

-- Context picker (all contexts).
o.bind("SUPER + ALT + PERIOD", "Context menu", "omarchy-context-switcher menu")

LUA
  echo "$CONFIG" | jq -r '
    .contexts[] | select(.shortcut != null and .shortcut != "") |
    "o.bind(\"SUPER + ALT + " + (.shortcut | ascii_upcase) + "\", \"" + (.name // .id) + " menu\", \"omarchy-context-switcher menu " + .id + "\")"
  '
  echo
  cat <<'LUA'
-- Context cycling (owned contexts of the focused monitor).
hl.unbind("SUPER + CTRL + ALT + TAB")
o.bind("SUPER + CTRL + ALT + TAB", "Next context", "omarchy-context-switcher context-next")
hl.unbind("SUPER + CTRL + ALT + SHIFT + TAB")
o.bind("SUPER + CTRL + ALT + SHIFT + TAB", "Previous context", "omarchy-context-switcher context-prev")

-- Move the active context to the monitor in that direction.
hl.unbind("SUPER + SHIFT + CTRL + ALT + LEFT")
o.bind("SUPER + SHIFT + CTRL + ALT + LEFT", "Move context left", "omarchy-context-switcher move-context left")
hl.unbind("SUPER + SHIFT + CTRL + ALT + RIGHT")
o.bind("SUPER + SHIFT + CTRL + ALT + RIGHT", "Move context right", "omarchy-context-switcher move-context right")
hl.unbind("SUPER + SHIFT + CTRL + ALT + UP")
o.bind("SUPER + SHIFT + CTRL + ALT + UP", "Move context up", "omarchy-context-switcher move-context up")
hl.unbind("SUPER + SHIFT + CTRL + ALT + DOWN")
o.bind("SUPER + SHIFT + CTRL + ALT + DOWN", "Move context down", "omarchy-context-switcher move-context down")

-- Workspace to monitor: use the same guard path as SUPER+backslash so the
-- workspace lands in the target monitor's active context/default manager.
hl.unbind("SUPER + SHIFT + ALT + LEFT")
o.bind("SUPER + SHIFT + ALT + LEFT", "Move workspace to left monitor", "omarchy-context-switcher move-workspace-to-monitor left")
hl.unbind("SUPER + SHIFT + ALT + RIGHT")
o.bind("SUPER + SHIFT + ALT + RIGHT", "Move workspace to right monitor", "omarchy-context-switcher move-workspace-to-monitor right")
hl.unbind("SUPER + SHIFT + ALT + UP")
o.bind("SUPER + SHIFT + ALT + UP", "Move workspace to up monitor", "omarchy-context-switcher move-workspace-to-monitor up")
hl.unbind("SUPER + SHIFT + ALT + DOWN")
o.bind("SUPER + SHIFT + ALT + DOWN", "Move workspace to down monitor", "omarchy-context-switcher move-workspace-to-monitor down")
LUA
  echo
  # Browser: launch the default Chrome profile explicitly — Omarchy's default
  # binding opens the last-used profile. Lives here (not the user's global
  # bindings.lua) so it tracks the plugin and disappears on disable/teardown.
  echo "$CONFIG" | jq -r '
    (.default_chrome_profile // "Default") as $p |
    "-- Browser: force the " + $p + " Chrome profile (Omarchy opens the last-used profile).",
    "hl.unbind(\"SUPER + SHIFT + B\")",
    # @sh quotes the profile shell-safely ('Default'), so the emitted Lua stays
    # valid (raw double quotes would terminate the Lua string early).
    "o.bind(\"SUPER + SHIFT + B\", \"Browser\", \"omarchy-context-switcher-launch " + ($p | @sh) + "\")"
  '
  echo
  # Slot keys: SUPER+1..0 goto, SUPER+SHIFT+1..0 move, SUPER+SHIFT+ALT+1..0 move-silent.
  cat <<'LUA'
-- Slot keys within the active context (uses code:10..19 for the number row).
-- Unbind Omarchy's default workspace-switching binds first.
LUA
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + ALT + code:" + $c + "\")" )
  '
  echo
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    [ range(1; $slots + 1) ] as $nums |
    ( $nums[] as $n |
      "o.bind(\"SUPER + code:" + (($n + 9) | tostring) + "\", \"Context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher goto " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + code:" + (($n + 9) | tostring) + "\", \"Move to context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher move " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + ALT + code:" + (($n + 9) | tostring) + "\", \"Silent move to context workspace " + ($n | tostring) + "\", \"omarchy-context-switcher move-silent " + ($n | tostring) + "\")" )
  '
  echo
  cat <<'LUA'
-- Cycle workspaces globally within contexts.
hl.unbind("SUPER + TAB")
hl.unbind("SUPER + SHIFT + TAB")
o.bind("SUPER + TAB", "Cycle workspace next", "omarchy-context-switcher cycle next")
o.bind("SUPER + SHIFT + TAB", "Cycle workspace previous", "omarchy-context-switcher cycle prev")

-- Cycle the active workspace to the next/prev monitor (context-aware).
hl.unbind("SUPER + backslash")
o.bind("SUPER + backslash", "Move workspace to next monitor", "omarchy-context-switcher cycle-monitor next")
o.bind("SUPER + SHIFT + backslash", "Move workspace to previous monitor", "omarchy-context-switcher cycle-monitor prev")
LUA
}

# An existing omarchy-menu.jsonc may carry whole-line // comments (e.g. the
# hey-tui managed block). jq --argjson rejects comments, so strip them before
# feeding the extension back in for merge-preserving regeneration / strip.
strip_comments() {
  # Read the file, drop whole-line comment lines (optionally indented), pass
  # everything else through unchanged. Missing file -> "{}" so the merge no-ops.
  if [[ ! -r "${1:-}" ]]; then echo "{}"; return; fi
  < "$1" jq -R -r 'select(test("^[[:space:]]*//") | not)'
}

# System-menu extension: a "Contexts" section. Each context is a submenu of
# launch items plus management actions (go-to, move-ws, modify items, edit)
# that summon the dedicated editor. "Add context" and "Edit JSON file" sit at
# the bottom of the picker.
gen_menu() {
  echo "$CONFIG" | jq --arg current "$current" '
    # One "Edit <folder>" entry per folder in the context, recursing into nested
# folders (path-encoded action; dot-free key to stay a single menu route).
def emit_folder_edits($cid; $base; $path; $items):
  reduce ($items | to_entries)[] as $e (.;
    if ($e.value.type // "") == "submenu" then
      (($e.key|tostring) as $k
       | ($path + (if $path == "" then $k else ("_" + $k) end)) as $p
       | .[($base + ".ef" + $p)] = { icon: "󰉋", label: ("Edit " + ($e.value.label // "")),
           action: ("omarchy-context-switcher reorder " + $cid + " " + (if $path == "" then $k else ($path + "." + $k) end)) }
       | emit_folder_edits($cid; $base; $p; ($e.value.items // [])))
    else . end);

def emit_edit($cid; $base; $path; $label; $items; $detailsAction):
  .[($base + ".~edit")] = { icon: "󰏪", label: ("Edit " + $label), action: ("omarchy-context-switcher reorder " + $cid + (if $path == "" then "" else (" " + $path) end)) }
  | .[($base + ".~edit.menu")] = { icon: "󰏪", label: ("Edit " + $label) }
  | .[($base + ".~edit.menu.!details")] = { icon: "󰏪", label: "Edit details", action: $detailsAction }
  | .[($base + ".~edit.menu.!add")] = { icon: "󰐕", label: "Add item", action: ("omarchy-context-switcher edit-item " + $cid + " " + (if $path == "" then "add" else ($path + ".add") end)) }
  | .[($base + ".~edit.menu.!reorder")] = { icon: "", label: "Move/Edit Items", action: ("omarchy-context-switcher reorder " + $cid + (if $path == "" then "" else (" " + $path) end)) }
  | emit_folder_edits($cid; ($base + ".~edit.menu"); ""; $items);

    def emit_items($cid; $base; $path; $profile; $items):
      reduce ($items | to_entries)[] as $e (.;
        if ($e.value.type // "") == "browser" then .
        elif ($e.value.type // "") == "submenu" then
          (($e.key|tostring) as $k
           | ($path + (if $path == "" then "" else "." end) + $k) as $p
           | ($base + "." + $e.value.label) as $sub
                  | (if ($e.value.icon // "") == "" then "󰉋" else $e.value.icon end) as $ic
       | .[$sub] = { icon: $ic, label: $e.value.label, target: $sub }
       | emit_items($cid; $sub; $p; $profile; ($e.value.items // [])))
        elif ($e.value.type // "") == "web" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰅂"), label: $e.value.label, action: ("omarchy-context-switcher-launch " + ($profile | @json) + " " + ($e.value.url | @json)) }
        elif ($e.value.type // "") == "mosh" or ($e.value.type // "") == "ssh" then
          # Remote command: "cd <workdir> && <command>"; workdir alone keeps an
          # interactive shell in that dir (a bare "cd" would exit immediately).
          ((((if ($e.value.command // "") != "" then
            ([(if ($e.value.workdir // "") != "" then ("cd " + $e.value.workdir) else empty end), $e.value.command] | join(" && "))
           elif ($e.value.workdir // "") != "" then ("cd " + $e.value.workdir + " && exec bash")
           else "" end))) as $rc |
           .[($base + "." + $e.value.label)] =
             { icon: ($e.value.icon // "󰒵"), label: $e.value.label,
               action: ("alacritty --title " + ($e.value.label | @json) +
                        (if ($e.value.type) == "mosh" then " -e mosh " else " -e ssh " end) +
                        (($e.value.herdr // $e.value.host) | @json) +
                        (if $rc == "" then "" else (" " + ($rc | @json)) end)) })
        elif ($e.value.type // "") == "terminal" then
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰆍"), label: $e.value.label, action: ("alacritty --title " + ($e.value.label | @json) + " -e sh -c " + ($e.value.command | @json)) }
        else
          .[($base + "." + $e.value.label)] = { icon: ($e.value.icon // "󰆍"), label: $e.value.label, action: $e.value.command }
        end);

    def emit_context($ctx):
      ($ctx.id) as $cid
      | ($ctx.icon // "󰌨") as $ic
      | ($ctx.name // $cid) as $cn
      | ($ctx.menu // []) as $items
      | ($ctx.chrome_profile // "") as $explicit
      | (.default_chrome_profile // "Default") as $dp
      | (if $explicit == "" then $dp else $explicit end) as $profile
      | .[("contexts." + $cid)] = { icon: $ic, label: $cn, target: ("contexts." + $cid + ".menu") }
      | .[("contexts." + $cid + ".menu")] = { icon: $ic, label: $cn }
      | (if ($current // "") == $cid then .
         else
           .[("contexts." + $cid + ".menu.!go-to")] = { icon: "󰁔", label: ("Go to " + $cn), action: ("omarchy-context-switcher switch " + $cid) }
           | .[("contexts." + $cid + ".menu.!move-ws")] = { icon: "󰄾", label: ("Move to " + $cn), action: ("omarchy-context-switcher move-workspace " + $cid) }
         end)
      | (if $explicit != "" then
           .[("contexts." + $cid + ".menu.!browser")] = { icon: "󰖟", label: "Browser", action: ("omarchy-context-switcher-launch " + ($profile | @json)) }
         else . end)
      | emit_items($cid; ("contexts." + $cid + ".menu"); ""; $profile; $items)
      | emit_edit($cid; ("contexts." + $cid + ".menu"); ""; $cn; $items; ("omarchy-context-switcher edit " + $cid));

    reduce .contexts[] as $ctx ({}; . + (emit_context($ctx)))
    | { contexts: { icon: "󰌨", label: "Contexts" } }
    + .
    + { "contexts.~add": { icon: "", label: "Add context", action: "omarchy-context-switcher edit new" },
        "contexts.~json": { icon: "", label: "Edit Config", action: "omarchy-context-switcher edit-json" },
        "contexts.~reload": { icon: "", label: "Reload config", action: "omarchy-context-switcher reload" } }' 2>&1
}

if [[ "$mode" == "selftest" ]]; then selftest; exit 0; fi

if [[ -n "$strip" ]]; then
  # Strip this plugin's contexts* routes from an existing menu extension,
  # preserving every other (user) key — used by disable/teardown so the
  # Omarchy system menu's user layer is never destroyed wholesale.
  # The extension is JSONC (whole-line // comments), so strip those before
  # parsing into jq's --argjson.
  jq -n --argjson m "$(strip_comments "$strip")" '
    reduce ($m | to_entries[]) as $e ({}; if ($e.key | startswith("contexts")) then . else .[$e.key] = $e.value end)'
  exit 0
fi

if [[ "$mode" == "bindings" ]]; then
  gen_bindings
else
  tmp_fresh=$(mktemp "${TMPDIR:-/tmp}/ctx-menu.XXXXXX") || exit 1
  trap 'rm -f "$tmp_fresh"' EXIT
  gen_menu > "$tmp_fresh"
  if [[ -n "$merge" && -s "$merge" ]]; then
    # Merge-preserving regeneration: keep every key of the existing menu
    # extension EXCEPT the contexts* routes this plugin owns, then layer the
    # fresh ones on top — the user's own system-menu entries survive every
    # regeneration (later entries override per-key, like the menu plugin's
    # own defaults+user merge).
    jq -n --argjson keep "$(strip_comments "$merge")" --argjson add "$(cat "$tmp_fresh")" '
      (reduce ($keep | to_entries[]) as $e
        ({}; if ($e.key | startswith("contexts")) then . else .[$e.key] = $e.value end)) + $add'
  else
    cat "$tmp_fresh"
  fi
fi
