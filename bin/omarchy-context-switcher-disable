#!/bin/bash
# omarchy-context-switcher-disable: turn the Context Switcher OFF and restore the
# default Omarchy workspace view.
#
# What this does:
#   1. Restores the default Omarchy workspace widget (omarchy.workspaces) to
#      the bar, replacing the context-switcher widget.
#   2. Consolidates every open workspace's windows down to a contiguous default
#      set (1..N) so the default workspace view shows them all.
#   3. Disables the context-switcher plugin.
#   4. Removes the generated context bindings + menu extension.
set -euo pipefail

export PATH="$HOME/.local/share/omarchy/bin:$PATH"
OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
PLUGIN_ID="context-switcher"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
BINDINGS_LUA="$HOME/.config/hypr/bindings.lua"
CTX_BINDINGS="$HOME/.config/hypr/context-bindings.lua"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

echo "=== Disabling context-switcher ==="

# 1. Restore the default workspace widget to the bar.
echo "--- Restoring default workspace widget ---"
if [[ -f "$SHELL_JSON" ]]; then
  cp -a "$SHELL_JSON" "$SHELL_JSON.bak.context-disable"
  # Replace context-switcher in left section with omarchy.workspaces (if the
  # default isn't already present); otherwise just drop context-switcher.
  T=$(mktemp "$SHELL_JSON.XXXXXX") || exit 1
  trap 'rm -f "$T"' EXIT
  jq '(.bar.layout.left) = (
        [.bar.layout.left[] | select(.id != "context-switcher" and .id != "omarchy.workspaces")]
        + [{"id": "omarchy.workspaces"}]
      )' "$SHELL_JSON" > "$T" && chmod 0644 "$T" && mv "$T" "$SHELL_JSON"
  trap - EXIT
fi

# 2. Consolidate all open workspaces to a contiguous default set (1..N).
#    Workspaces are currently spread across contexts (1..10, 11..20, ...).
#    Move every window to the lowest occupied set so the default view shows all.
echo "--- Consolidating workspaces ---"
python3 - "$OMARCHY_PATH" <<'PY'
import json, subprocess, sys, re, shlex

def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def dsp(expr):
    # Dispatch a Hyprland 0.56 Lua dispatcher via hyprctl eval.
    # shlex.quote protects the whole Lua expression so inner quotes survive the
    # shell layer intact.
    run("hyprctl eval " + shlex.quote("hl.dispatch(" + expr + ")"))

# Occupied regular (positive, non-special) workspaces, sorted ascending.
ws = run("hyprctl workspaces -j").stdout
wsj = json.loads(ws)
occupied = sorted(int(w["id"]) for w in wsj if int(w["id"]) > 0 and w.get("windows", 0) > 0)
if not occupied:
    sys.exit(0)

# Target a contiguous 1..N set.
targets = list(range(1, len(occupied) + 1))

# Get all clients and move each window to its new workspace.
clients = json.loads(run("hyprctl clients -j").stdout)
old_to_new = {old: new for old, new in zip(occupied, targets)}

for old, new in old_to_new.items():
    if old == new:
        continue
    addrs = [c["address"] for c in clients if c.get("workspace", {}).get("id") == old]
    for addr in addrs:
        dsp(f'hl.dsp.window.move({{ workspace = "{new}", follow = false, window = "address:{addr}" }})')

print(f"Moved windows from {old_to_new}")
PY

# 3. Disable the plugin.
echo "--- Disabling plugin ---"
omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true

# 4. Remove generated context bindings source + menu extension.
echo "--- Cleaning generated context bindings/menu ---"
if [[ -f "$BINDINGS_LUA" ]]; then
  cp -a "$BINDINGS_LUA" "$BINDINGS_LUA.bak.context-disable"
  # Strip both the dofile include and the generated-bindings banner (see
  # teardown) so no orphaned comment stays behind after disabling.
  python3 - "$BINDINGS_LUA" <<'PY'
import sys
p = sys.argv[1]
keep = [l for l in open(p).read().splitlines()
        if "context-bindings.lua" not in l
        and not l.startswith("-- Context Switcher generated bindings")]
open(p, "w").write("\n".join(keep).rstrip() + "\n")
PY
fi
rm -f "$CTX_BINDINGS"
rm -f "$MENU_EXT"

echo "--- Reloading ---"
hyprctl reload >/dev/null 2>&1 || true
omarchy-restart-shell >/dev/null 2>&1 || true

echo ""
echo "Done. Default workspace view restored. context-switcher is disabled."
echo "To re-enable: run omarchy-context-switcher install.sh"
