#!/bin/bash
# omarchy-context-switcher-setup: enforce the Context Switcher bar state and generated
# files every time the service starts. Self-healing: after disable/re-enable,
# a teardown, or an omarchy rewrite, this restores the workspace widget, the
# Hyprland bindings file + include, and the launcher menu extension.
# Idempotent. Called from the service's Component.onCompleted.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SHELL_JSON="$HOME/.config/omarchy/shell.json"
HYPRE="$HOME/.config/hypr"
CTX_BINDINGS="$HYPRE/context-bindings.lua"
BINDINGS_LUA="$HYPRE/bindings.lua"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

reload_binds=0

# 1. Bar layout: exactly one workspace widget — context-switcher (drop any
#    leftover omarchy.workspaces). Applies on the next shell start.
if [[ -f "$SHELL_JSON" ]]; then
  jq '(.bar.layout.left) = ([.bar.layout.left[]? | select(.id != "omarchy.workspaces" and .id != "context-switcher")] + [{"id": "context-switcher"}])' \
    "$SHELL_JSON" > "$SHELL_JSON.tmp" && mv "$SHELL_JSON.tmp" "$SHELL_JSON"
fi

# 2. Regenerate files teardown (or a partial install) removed.
# Only regenerate when the config exists (a missing config means first run —
# the service bootstraps it and regenerates these itself).
CFG_OK=""
[[ -f "$HOME/.config/context-switcher/config.json" ]] && CFG_OK=1
if [[ ! -s "$CTX_BINDINGS" && -n "$CFG_OK" ]]; then
  if omarchy-context-switcher-generate --bindings > "$CTX_BINDINGS" 2>/dev/null; then
    reload_binds=1
  fi
fi
if [[ ! -s "$MENU_EXT" && -n "$CFG_OK" ]]; then
  omarchy-context-switcher-generate --menu > "$MENU_EXT" 2>/dev/null || true
fi

# 3. bindings.lua include (dropped by teardown or omarchy rewrites).
if [[ -f "$BINDINGS_LUA" ]] && ! grep -q 'context-bindings.lua' "$BINDINGS_LUA"; then
  cat >> "$BINDINGS_LUA" <<'LUA'

-- Context Switcher generated bindings (menus, slots, cycle).
dofile(os.getenv("HOME") .. "/.config/hypr/context-bindings.lua")
LUA
  reload_binds=1
fi

# 4. Reload Hyprland when the bindings file/include changed so the keys load
#    without a compositor restart.
if [[ "$reload_binds" == 1 ]]; then
  hyprctl reload >/dev/null 2>&1 || true
fi
