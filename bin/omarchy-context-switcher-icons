#!/usr/bin/env python3
# omarchy-context-switcher-icons: fetch the Nerd Fonts cheat-sheet glyph map and cache
# it as compact JSON for the icon picker (panel).
#
#   omarchy-context-switcher-icons           ensure the cache exists (downloads if missing)
#   omarchy-context-switcher-icons --refresh force a redownload
#
# Prints the cache path on success, or "error: <reason>" on failure (the panel
# shows the error and offers Retry).
import json
import os
import re
import sys
import urllib.request

CACHE = os.path.expanduser("~/.cache/context-switcher/nerd-icons.json")
URL = "https://www.nerdfonts.com/cheat-sheet"


def main() -> int:
    force = "--refresh" in sys.argv
    if not force and os.path.exists(CACHE) and os.path.getsize(CACHE) > 0:
        print(CACHE)
        return 0

    try:
        req = urllib.request.Request(URL, headers={"User-Agent": "omarchy-context-switcher-switcher"})
        html = urllib.request.urlopen(req, timeout=25).read().decode("utf-8", "replace")
        start = html.find("const glyphs = {")
        if start < 0:
            print("error: glyph map not found in cheat sheet")
            return 1
        sect = html[start:html.find("</script>", start)]
        body = sect[sect.index("{"):sect.rindex("}") + 1]
        body = re.sub(r",\s*}", "}", body)  # JS trailing comma -> JSON
        data = json.loads(body)
        entries = []
        for cls, hexv in data.items():
            rest = cls[3:]  # strip "nf-"
            set_, _, name = rest.partition("-")
            entries.append({"set": set_, "name": name, "hex": hexv})
        if not entries:
            print("error: empty glyph list")
            return 1
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(entries, f, separators=(",", ":"))
        os.replace(tmp, CACHE)
        print(CACHE)
        return 0
    except Exception as e:  # network/parse failures: report, keep any old cache
        print("error: " + str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
