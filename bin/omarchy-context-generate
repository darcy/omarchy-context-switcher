#!/bin/bash
# omarchy-context-generate: generate keybindings + menu extension from
# ~/.config/context-switcher/config.json for the Context Switcher plugin.
#
# Outputs (to stdout):
#   --bindings   Lua keybindings (Super+Alt+<shortcut> menus, Super+Alt+. main)
#   --menu       omarchy-menu.jsonc shell menu extension
set -euo pipefail

CONFIG_FILE="${HOME}/.config/context-switcher/config.json"
[[ -f "$CONFIG_FILE" ]] || { echo "error: $CONFIG_FILE not found" >&2; exit 1; }
CONFIG=$(cat "$CONFIG_FILE")
[[ -n "$CONFIG" ]] || { echo "error: empty config" >&2; exit 1; }

mode=""
while (( $# )); do
  case "$1" in
    --bindings) mode=bindings ;;
    --menu) mode=menu ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
done
[[ -n "$mode" ]] || { echo "usage: $0 --bindings|--menu" >&2; exit 1; }

gen_bindings() {
  cat <<'LUA'
-- Generated by omarchy-context-generate. Source: ~/.config/context-switcher/config.json.
-- Context Switcher keybindings.

-- Main context menu (all contexts).
o.bind("SUPER + ALT + PERIOD", "Context menu", "omarchy menu summon contexts")

LUA
  echo "$CONFIG" | jq -r '
    .contexts[] | select(.shortcut != null and .shortcut != "") |
    "o.bind(\"SUPER + ALT + " + (.shortcut | ascii_upcase) + "\", \"" + (.name // .id) + " menu\", \"omarchy menu summon contexts." + .id + "\")"
  '
  echo
  # Slot keys: SUPER+1..0 goto, SUPER+SHIFT+1..0 move, SUPER+SHIFT+ALT+1..0 move-silent.
  cat <<'LUA'
-- Slot keys within the active context (uses code:10..19 for the number row).
-- Unbind Omarchy's default workspace-switching binds first.
LUA
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + code:" + $c + "\")" ),
    ( range(1; $slots + 1) | (. + 9 | tostring) as $c | "hl.unbind(\"SUPER + SHIFT + ALT + code:" + $c + "\")" )
  '
  echo
  echo "$CONFIG" | jq -r '
    .slots as $slots |
    [ range(1; $slots + 1) ] as $nums |
    ( $nums[] as $n |
      "o.bind(\"SUPER + code:" + (($n + 9) | tostring) + "\", \"Context workspace " + ($n | tostring) + "\", \"omarchy-context goto " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + code:" + (($n + 9) | tostring) + "\", \"Move to context workspace " + ($n | tostring) + "\", \"omarchy-context move " + ($n | tostring) + "\")" ),
    ( $nums[] as $n |
      "o.bind(\"SUPER + SHIFT + ALT + code:" + (($n + 9) | tostring) + "\", \"Silent move to context workspace " + ($n | tostring) + "\", \"omarchy-context move-silent " + ($n | tostring) + "\")" )
  '
  echo
  cat <<'LUA'
-- Cycle workspaces globally within contexts.
hl.unbind("SUPER + TAB")
hl.unbind("SUPER + SHIFT + TAB")
o.bind("SUPER + TAB", "Cycle workspace next", "omarchy-context cycle next")
o.bind("SUPER + SHIFT + TAB", "Cycle workspace previous", "omarchy-context cycle prev")

-- Cycle the active workspace to the next/prev monitor (context-aware).
hl.unbind("SUPER + backslash")
o.bind("SUPER + backslash", "Move workspace to next monitor", "omarchy-context cycle-monitor next")
o.bind("SUPER + SHIFT + backslash", "Move workspace to previous monitor", "omarchy-context cycle-monitor prev")
LUA
}

gen_menu() {
  # Build the whole menu object with jq so strings are escaped correctly.
  echo "$CONFIG" | jq '
    .default_chrome_profile as $dp |
    reduce .contexts[] as $ctx ({};
      $ctx.id as $cid |
      ($ctx.chrome_profile // $dp // "Default") as $profile |
      . as $acc |
      $acc
      | .["contexts." + $cid] = { icon: ($ctx.icon // "󰯆"), label: ($ctx.name // $cid), target: ("contexts." + $cid + ".menu") }
      | .["contexts." + $cid + ".menu"] = { icon: ($ctx.icon // "󰯆"), label: ($ctx.name // $cid) }
      | .["contexts." + $cid + ".menu.!go-to"] = { icon: "󰁔", label: ("Go to " + ($ctx.name // $cid)), action: ("omarchy-context switch " + $cid) }
      | reduce ($ctx.menu // [])[] as $item (.;
          .["contexts." + $cid + ".menu." + $item.label] =
            (if $item.type == "web" then { icon: ($item.icon // "󰅂"), label: $item.label, action: ("omarchy-launch-webapp " + ($item.url | @json)) }
             elif $item.type == "browser" then { icon: ($item.icon // "󰈙"), label: $item.label, action: "omarchy-launch-browser" }
             elif $item.type == "mosh" then { icon: ($item.icon // "󰒵"), label: $item.label, action: ("alacritty --title " + ($item.label | @json) + " -e mosh " + ($item.host | @json)) }
             elif $item.type == "terminal" then { icon: ($item.icon // "󰆍"), label: $item.label, action: ("alacritty --title " + ($item.label | @json) + " -e sh -c " + ($item.command | @json)) }
             else { icon: ($item.icon // "󰆍"), label: $item.label, action: $item.command } end)
        )
      | .["contexts." + $cid + ".menu.~move-ws"] = { icon: "󰄾", label: ("Move to " + ($ctx.name // $cid)), action: ("omarchy-context move-workspace " + $cid) }
    ) | { contexts: { icon: "󰱒", label: "Contexts" } } + .' 2>&1
}

if [[ "$mode" == "bindings" ]]; then
  gen_bindings
else
  gen_menu
fi
