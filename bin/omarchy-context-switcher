#!/bin/bash
# omarchy-context-switcher: drive the Context Switcher service via IPC.
# Thin wrapper over `omarchy-shell context <method> <args>`.
set -euo pipefail

usage() {
  cat <<EOF
Usage: omarchy-context-switcher <command> [args]

Commands:
  switch <context>      Switch to context, restoring last workspace
  goto <slot>           Go to workspace slot in current context
  move <slot>           Move active window to slot in current context
  move-silent <slot>    Move active window silently to slot
  move-workspace <ctx>  Move active workspace to first empty slot in context
  cycle next|prev       Cycle to next/prev workspace globally, updating context
  cycle-monitor [dir]   Move active workspace to next/prev monitor, focus it there
  next                  Switch to next context
  prev                  Switch to previous context
  current               Print current context name
  list                  List all contexts
  menu [context]        Open the system menu (picker, or a context's items)
  edit new              Open the editor to add a context
  edit <ctx>            Open the editor for a context
  edit-item <ctx> add   Open the editor to add an item (top level)
  edit-item <ctx> <path>     Edit the item at index path (e.g. 2, 2.1 for nested submenu items)
  edit-item <ctx> <path>.add Open the editor to add an item inside the submenu at <path>
  reorder <ctx> [path]  Open the editor to reorder a context's items (or a submenu's, via path)
  edit-json             Edit the config file
  reload                Reload the config (after editing it)
  add-item <ctx> <title> <url> [icon]  Add a web item to a context (top-level menu)
  rename-item <ctx> <old-title> <new-title>  Rename an item (top-level menu)
  set-item-icon <ctx> <title> <icon>  Change an item's icon (top-level menu)
  delete-item <ctx> <title>        Delete an item from a context (top-level menu)
  validate              Validate config.json
  status                Print service status JSON
  skill link|unlink|status  Opt-in: expose the bundled agent skill to Claude Code,
                      Codex, Pi/Opencode and Gemini skill dirs (NOT installed by default)
EOF
}

CONFIG_FILE="${HOME}/.config/context-switcher/config.json"

if (( $# < 1 )); then
  usage
  exit 1
fi

cmd="$1"
shift

case "$cmd" in
  switch)        omarchy-shell context switchTo "${1:-}" ;;
  goto)          omarchy-shell context goto "${1:-}" ;;
  move)          omarchy-shell context move "${1:-}" ;;
  move-silent)   omarchy-shell context moveSilent "${1:-}" ;;
  move-workspace) omarchy-shell context moveWorkspace "${1:-}" ;;
  cycle)         omarchy-shell context cycle "${1:-next}" ;;
  cycle-monitor) omarchy-shell context cycleMonitor "${1:-next}" ;;
  next)          omarchy-shell context next ;;
  prev)          omarchy-shell context prev ;;
  current)       omarchy-shell context current ;;
  list)          omarchy-shell context list ;;
  menu)          if [[ -n "${1:-}" ]]; then omarchy menu summon "contexts.${1:-}"; else omarchy menu summon contexts; fi ;;
  edit)          if [[ "${1:-}" == "new" ]]; then omarchy-shell context edit editContextNew "" 0
                 else omarchy-shell context edit editContext "${1:-}" 0; fi ;;
  edit-item)     if [[ -z "${2:-}" ]]; then echo "Usage: omarchy-context-switcher edit-item <ctx> add|<path>[.add]" >&2; exit 1; fi
                 omarchy-shell context edit editItem "${1:-}" "${2:-}" ;;
  reorder)       omarchy-shell context edit reorder "${1:-}" "${2:-}" ;;
  edit-json)     alacritty --title 'context-switcher config' -e nvim ~/.config/context-switcher/config.json ;;
  reload)        omarchy-shell context reloadConfig ;;
  add-context|create-context)
    profile=$(jq -r '.default_chrome_profile // "Default"' "$CONFIG_FILE" 2>/dev/null)
    [[ -n "$profile" && "$profile" != "null" ]] || profile="Default"
    omarchy-shell context addContext "${1:-}" "${2:-}" "${3:-}" "$profile" ;;
  rename-context) omarchy-shell context renameContext "${1:-}" "${2:-}" ;;
  set-shortcut)  omarchy-shell context setShortcut "${1:-}" "${2:-}" ;;
  set-icon)      omarchy-shell context setIcon "${1:-}" "${2:-}" ;;
  set-profile)   if [[ "${2:-}" == "-" ]]; then omarchy-shell context setChromeProfile "${1:-}" ""; else omarchy-shell context setChromeProfile "${1:-}" "${2:-}"; fi ;;
  delete-context) omarchy-shell context deleteContext "${1:-}" "${2:-}" ;;
  add-item)      omarchy-shell context addItem "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
  rename-item)   omarchy-shell context renameItem "${1:-}" "${2:-}" "${3:-}" ;;
  set-item-icon) omarchy-shell context setItemIcon "${1:-}" "${2:-}" "${3:-}" ;;
  delete-item)   omarchy-shell context deleteItem "${1:-}" "${2:-}" ;;
  validate)      omarchy-shell context validate ;;
  status)        omarchy-shell context status ;;
  skill)
    SKILL_SRC="$HOME/.config/omarchy/plugins/context-switcher/skills/context-switcher"
    SKILL_DIRS=("$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.pi/agent/skills" "$HOME/.gemini/config/skills")
    case "${1:-}" in
      link)
        [[ -d "$SKILL_SRC" ]] || { echo "error: plugin skill missing at $SKILL_SRC" >&2; exit 1; }
        echo "Linking the context-switcher agent skill into coding-agent skill dirs."
        echo "This makes agent instructions from this plugin auto-discoverable by"
        echo "Claude Code, Codex, Pi/Opencode, and Gemini — an explicit trust"
        echo "expansion. It is opt-in; nothing is linked on install."
        for d in "${SKILL_DIRS[@]}"; do mkdir -p "$d"; ln -sfn "$SKILL_SRC" "$d/context-switcher"; done
        echo "Linked. Remove with: omarchy-context-switcher skill unlink" ;;
      unlink)
        for d in "${SKILL_DIRS[@]}"; do
          link="$d/context-switcher"
          [[ -L "$link" && "$(readlink "$link")" == "$SKILL_SRC" ]] && rm -f "$link"
        done
        echo "Unlinked (the SKILL.md still ships with the plugin)" ;;
      status)
        for d in "${SKILL_DIRS[@]}"; do
          if [[ -L "$d/context-switcher" ]]; then echo "linked   $d/context-switcher"; else echo "not set  $d/context-switcher"; fi
        done ;;
      *) echo "Usage: omarchy-context-switcher skill link|unlink|status" >&2; exit 1 ;;
    esac ;;
  -h|--help|help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
